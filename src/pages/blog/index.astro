---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { person } from '../../data/site';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: `${person.name} — Blog`,
  author: { '@type': 'Person', name: person.name },
  url: new URL('/blog', Astro.site).href,
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    datePublished: p.data.pubDate.toISOString(),
    url: new URL(`/blog/${p.id}`, Astro.site).href,
  })),
};
---

<Base
  title={`Blog — ${person.name}`}
  description={`Writing by ${person.name} on backend engineering, distributed systems, and performance.`}
  jsonLd={jsonLd}
>
  <section class="section">
    <h1>Blog</h1>
    <p class="muted">Notes on backend engineering, distributed systems, and performance.</p>

    {posts.length === 0 ? (
      <p class="muted">No posts yet — check back soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            <a href={`/blog/${post.id}`}>{post.data.title}</a>
            <p class="desc">{post.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>
